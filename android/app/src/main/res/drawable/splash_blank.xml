<?xml version="1.0" encoding="utf-8"?>
<!-- Прозрачный vector drawable для windowSplashScreenAnimatedIcon
     (Android 12+). Shape-drawable система не принимает и подставляет
     launcher icon. Пустой vector делает иконку невидимой — splash
     показывает только синий фон. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0L108,0L108,108L0,108Z" />
</vector>
