<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector drawable для windowSplashScreenAnimatedIcon на Android 12+.
  Залит фирменным синим #1369CD на 240×240dp — стандартный размер
  splash-иконки в Android 12 API. Раньше задавали 108×108: система
  ресэмплила в 240×240 и оставляла видимое «обрамление» 60dp по краям,
  где icon-background был отдельным цветом. Юзер видел два оттенка
  синего в одной точке.

  Цвет хардкодом, потому что в vector drawable нельзя ссылаться на
  @color/* — Android Studio инлайнит значение на этапе сборки.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <path
        android:fillColor="#1369CD"
        android:pathData="M0,0L240,0L240,240L0,240Z" />
</vector>
